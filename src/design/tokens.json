{
  "$meta": {
    "projeto": "Gerador de Facas ProFood",
    "origem": "Desenhado do zero. Sem screenshots do original; nada medido ou copiado do Faca Gráfica. Direção: ferramenta técnica tipo CAD, sóbria, números em fonte mono.",
    "accent": "placeholder neutro (azul-tinta). /replica-brand troca pelos valores da marca ProFood sem mudar nomes de papéis.",
    "linhas_de_faca": "Vermelho/verde/magenta são convenção da indústria gráfica, não marca. Valores de tela ajustados para contraste >= 3:1 no canvas; no PDF de produção viram cores especiais puras."
  },
  "color": {
    "bg":              "#F5F6F7",
    "surface":         "#FFFFFF",
    "surface-sunken":  "#EDEFF2",
    "canvas":          "#FCFCFB",
    "canvas-grid":     "#E4E7EB",
    "border":          "#DCE0E5",
    "border-strong":   "#BFC6CE",
    "border-input":    "#7A8491",
    "text":            "#14181D",
    "text-muted":      "#525C68",
    "text-subtle":     "#66707C",
    "text-disabled":   "#9AA2AC",
    "accent":          "#1F4E79",
    "accent-hover":    "#173C5E",
    "accent-active":   "#112D47",
    "on-accent":       "#FFFFFF",
    "accent-soft":     "#E8EEF5",
    "on-accent-soft":  "#1A4267",
    "focus":           "#1F4E79",
    "danger":          "#B42318",
    "danger-hover":    "#912018",
    "on-danger":       "#FFFFFF",
    "danger-soft":     "#FEF3F2",
    "on-danger-soft":  "#912018",
    "success":         "#067647",
    "success-soft":    "#ECFDF3",
    "on-success-soft": "#05603A",
    "warning":         "#B54708",
    "warning-soft":    "#FFF8EB",
    "on-warning-soft": "#93370D",
    "line-cut":        "#D7191C",
    "line-crease":     "#12823B",
    "line-perf":       "#C2188F",
    "line-bleed":      "#2B7BB9",
    "line-dim":        "#3D4752",
    "glue-fill":       "#F3D27A"
  },
  "font": {
    "sans": "'IBM Plex Sans Variable', ui-sans-serif, system-ui, sans-serif",
    "mono": "'IBM Plex Mono', ui-monospace, 'SFMono-Regular', monospace"
  },
  "text": {
    "xs":  { "size": "12px", "line": "16px" },
    "sm":  { "size": "14px", "line": "20px" },
    "md":  { "size": "16px", "line": "24px" },
    "lg":  { "size": "20px", "line": "28px" },
    "xl":  { "size": "28px", "line": "36px" },
    "2xl": { "size": "40px", "line": "48px" }
  },
  "weight": { "regular": 400, "medium": 500, "semibold": 600 },
  "space": { "0": "0", "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "20px", "6": "24px", "8": "32px", "10": "40px", "12": "48px", "16": "64px" },
  "radius": { "sm": "4px", "md": "6px", "lg": "10px", "full": "9999px" },
  "shadow": {
    "sm": "0 1px 2px rgb(20 24 29 / 0.06)",
    "md": "0 2px 8px rgb(20 24 29 / 0.08), 0 1px 2px rgb(20 24 29 / 0.06)",
    "lg": "0 12px 32px rgb(20 24 29 / 0.14), 0 2px 6px rgb(20 24 29 / 0.08)"
  },
  "motion": {
    "fast": "120ms",
    "base": "200ms",
    "slow": "320ms",
    "ease": "cubic-bezier(0.2, 0, 0, 1)"
  },
  "layout": {
    "header-h": "56px",
    "editor-panel-w": "360px",
    "content-max": "1200px",
    "bp-sm": "640px",
    "bp-md": "768px",
    "bp-lg": "1024px",
    "bp-xl": "1280px",
    "control-sm": "32px",
    "control-md": "40px",
    "control-lg": "48px"
  },
  "pairs": [
    { "fg": "text",            "bg": "bg",            "min": 4.5, "uso": "texto de página" },
    { "fg": "text",            "bg": "surface",       "min": 4.5, "uso": "texto em card/painel" },
    { "fg": "text",            "bg": "surface-sunken","min": 4.5, "uso": "texto em área rebaixada" },
    { "fg": "text-muted",      "bg": "bg",            "min": 4.5, "uso": "descrição" },
    { "fg": "text-muted",      "bg": "surface",       "min": 4.5, "uso": "label, ajuda" },
    { "fg": "text-muted",      "bg": "surface-sunken","min": 4.5, "uso": "ajuda em área rebaixada" },
    { "fg": "text-subtle",     "bg": "surface",       "min": 4.5, "uso": "unidade mm, placeholder" },
    { "fg": "text-subtle",     "bg": "canvas",        "min": 4.5, "uso": "legenda do viewer" },
    { "fg": "on-accent",       "bg": "accent",        "min": 4.5, "uso": "botão primário" },
    { "fg": "on-accent",       "bg": "accent-hover",  "min": 4.5, "uso": "botão primário hover" },
    { "fg": "on-accent-soft",  "bg": "accent-soft",   "min": 4.5, "uso": "chip ativo, badge" },
    { "fg": "accent",          "bg": "surface",       "min": 4.5, "uso": "link, botão ghost" },
    { "fg": "accent",          "bg": "bg",            "min": 4.5, "uso": "link na página" },
    { "fg": "on-danger",       "bg": "danger",        "min": 4.5, "uso": "botão destrutivo" },
    { "fg": "danger",          "bg": "surface",       "min": 4.5, "uso": "mensagem de erro do campo" },
    { "fg": "on-danger-soft",  "bg": "danger-soft",   "min": 4.5, "uso": "alerta de erro" },
    { "fg": "on-success-soft", "bg": "success-soft",  "min": 4.5, "uso": "alerta de sucesso" },
    { "fg": "on-warning-soft", "bg": "warning-soft",  "min": 4.5, "uso": "alerta de regra do modelo" },
    { "fg": "text",            "bg": "canvas",        "min": 4.5, "uso": "cotas no viewer" },
    { "fg": "border-input",    "bg": "surface",       "min": 3.0, "uso": "borda de input (não-texto)" },
    { "fg": "focus",           "bg": "surface",       "min": 3.0, "uso": "anel de foco" },
    { "fg": "focus",           "bg": "bg",            "min": 3.0, "uso": "anel de foco na página" },
    { "fg": "danger",          "bg": "surface",       "min": 3.0, "uso": "borda de input inválido" },
    { "fg": "line-cut",        "bg": "canvas",        "min": 3.0, "uso": "linha de corte" },
    { "fg": "line-crease",     "bg": "canvas",        "min": 3.0, "uso": "linha de vinco" },
    { "fg": "line-perf",       "bg": "canvas",        "min": 3.0, "uso": "linha de serrilha" },
    { "fg": "line-bleed",      "bg": "canvas",        "min": 3.0, "uso": "linha de sangria" },
    { "fg": "line-dim",        "bg": "canvas",        "min": 4.5, "uso": "linha e texto de cota" },
    { "fg": "line-cut",        "bg": "glue-fill",     "min": 3.0, "uso": "corte sobre área de cola" },
    { "fg": "line-crease",     "bg": "glue-fill",     "min": 3.0, "uso": "vinco sobre área de cola" }
  ]
}
