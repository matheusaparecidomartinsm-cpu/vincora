# Copie para .env.local e preencha com as chaves do SEU projeto Supabase
# (Painel do Supabase → Project Settings → API Keys). Nunca faça commit do .env.local.

# URL do projeto, ex.: https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Chave publicável (sb_publishable_...) ou a antiga "anon". Pode ir para o navegador.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave secreta (sb_secret_...) ou a antiga "service_role". SÓ servidor: convite por e-mail e exclusão de conta.
SUPABASE_SECRET_KEY=
# Endereço público do app (usado nos links dos e-mails), ex.: https://facas.profood.com.br
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sem NEXT_PUBLIC_SUPABASE_URL o app roda em modo local: sem login, dados no navegador.
